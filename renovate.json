{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lasuillard-s/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "npm install (?:-g|--global) (?<content>.+)\n",
        "(?<packageName>(?:@[a-zA-Z0-9._-]+\\/)?[a-zA-Z0-9._-]+)@(?<currentValue>[0-9A-Za-z.+-]+)"
      ],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "pip install (?<content>.+)\n",
        "(?<packageName>[A-Za-z0-9][A-Za-z0-9._-]*)==(?<currentValue>[0-9A-Za-z.+!_-]+)"
      ],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Group non-major npm runtime dependencies",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Runtime Dependencies (non-major)",
      "groupSlug": "runtime-dependencies",
      "automerge": false
    },
    {
      "description": "Schedule custom-extracted workflow tools monthly",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "schedule": [
        "* 9-17 1 * *"
      ]
    },
    {
      "description": "Group non-major workflow tool updates for manual review",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Workflow Tools (non-major)",
      "groupSlug": "workflow-tools",
      "automerge": false
    },
    {
      "description": "Group non-major Terraform provider updates monthly",
      "matchManagers": [
        "terraform"
      ],
      "matchDatasources": [
        "terraform-provider"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Terraform Providers (non-major)",
      "groupSlug": "terraform-providers",
      "schedule": [
        "* 9-17 1 * *"
      ]
    }
  ]
}
