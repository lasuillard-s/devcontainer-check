# Probot
# -----------------------------------------------------------------------------
# https://probot.github.io/docs/configuration/

# If `--host` option of `probot run` does not work, you can use `HOST` instead:
# HOST=0.0.0.0

# * Probot will not process events until the required environment variables are set.
# Use "trace" to get verbose logging or `info` to show less
LOG_LEVEL=debug

# Go to https://smee.io/new set this to the URL that you are redirected to.
WEBHOOK_PROXY_URL=

# Your GitHub App details
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# Application configuration
# -----------------------------------------------------------------------------
# See src/config.ts for available configuration options.

# Required runner repository in owner/repo format for public/unknown repositories
RUNNER_REPOSITORY=

# Optional runner repository for private target repositories
# RUNNER_REPOSITORY_FOR_PRIVATE=

# Set to true to dispatch private targets to the public runner when no private runner is configured
# RUNNER_REPOSITORY_USE_PUBLIC_FOR_PRIVATE=false

# Workflow dispatch options
# CHECK_WORKFLOW_NAME=devcontainer-check.yaml
# CHECK_WORKFLOW_REF=~DEFAULT_BRANCH
# CHECK_WORKFLOW_INPUTS_ARTIFACT_NAME=workflow-inputs
# CHECK_WORKFLOW_INPUTS_ARTIFACT_PATH=inputs.json

# Branch filters (comma-separated, supports glob)
# PUSH_BRANCHES=~DEFAULT_BRANCH
# PR_BRANCHES=~DEFAULT_BRANCH
