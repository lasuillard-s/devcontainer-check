{
	"name": "devcontainer-check",
	"version": "0.1.0",
	"private": true,
	"description": "A GitHub App to automate validating your repository dev container configuration.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lasuillard-s/devcontainer-check.git"
	},
	"author": {
		"name": "Yuchan Lee",
		"url": "https://github.com/lasuillard",
		"email": "lasuillard@gmail.com"
	},
	"homepage": "https://github.com/lasuillard-s/devcontainer-check",
	"keywords": [
		"probot",
		"github",
		"probot-app"
	],
	"scripts": {
		"dev": "probot run ./dist/src/app.js",
		"dev:watch": "nodemon --watch ./src --ext js,ts --exec 'npm run build; npm run dev'",
		"build": "tsc",
		"build:watch": "tsc --watch",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"test:watch": "vitest --silent --watch"
	},
	"dependencies": {
		"probot": "^13.4.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.5",
		"@eslint/js": "10.0.1",
		"@types/node": "^20.0.0",
		"@vitest/coverage-v8": "^2.1.9",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "62.9.0",
		"globals": "^17.5.0",
		"nock": "^14.0.5",
		"nodemon": "^3.1.14",
		"prettier": "3.8.2",
		"smee-client": "^2.0.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vitest": "^2.0.0"
	},
	"overrides": {
		"@types/pg": "8.15.1"
	},
	"type": "module"
}
