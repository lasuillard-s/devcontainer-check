{
	"name": "devcontainer-check",
	"version": "0.1.0",
	"private": true,
	"description": "A GitHub App to automate validating your repository dev container configuration.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lasuillard-s/devcontainer-check.git"
	},
	"author": {
		"name": "Yuchan Lee",
		"url": "https://github.com/lasuillard",
		"email": "lasuillard@gmail.com"
	},
	"homepage": "https://github.com/lasuillard-s/devcontainer-check",
	"keywords": [
		"probot",
		"github",
		"probot-app"
	],
	"scripts": {
		"dev": "probot run ./dist/src/app.js",
		"dev:watch": "nodemon --watch ./src --ext js,ts --exec 'npm run build; npm run dev'",
		"build": "tsc",
		"build:watch": "tsc --watch",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"test:watch": "vitest --silent --watch"
	},
	"packageManager": "npm@11.16.0",
	"dependencies": {
		"adm-zip": "^0.5.17",
		"minimatch": "^10.2.5",
		"probot": "^14.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.5",
		"@eslint/js": "10.0.1",
		"@types/adm-zip": "0.5.8",
		"@types/node": "24.13.0",
		"@vercel/config": "0.5.1",
		"@vitest/coverage-v8": "4.1.8",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "63.0.1",
		"globals": "17.6.0",
		"ioredis": "5.11.1",
		"nock": "14.0.15",
		"nodemon": "3.1.14",
		"prettier": "3.8.3",
		"smee-client": "5.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.1",
		"vitest": "4.1.8"
	},
	"overrides": {
		"@types/pg": "8.20.0"
	},
	"type": "module"
}
